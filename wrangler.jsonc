{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armazemespetinho",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "build": {
    "command": "bun run build",
    "output_dir": ".output",
  },
}
